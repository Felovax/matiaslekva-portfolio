---
// Forsiden, og den eneste siden. Den setter sammen komponentene og henter
// alt innhold fra src/data/.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Seksjon from '../components/Seksjon.astro';
import ProsjektKort from '../components/ProsjektKort.astro';
import Footer from '../components/Footer.astro';
import { profil, teknologi } from '../data/profil';
import { prosjekter } from '../data/prosjekter';
import { erfaring, kurs } from '../data/erfaring';
---

<Layout tittel={`${profil.navn} – backend, database og sikkerhet`} beskrivelse={profil.hovedbudskap}>
  <Header />

  <main>
    {/* Fase 2: dungeonen kommer inn her, over teksten */}
    <section id="start" class="hero">
      <div class="container">
        <p class="hei">Hei, jeg er {profil.navn}</p>
        <h1>{profil.hovedbudskap}</h1>
        <p class="intro">{profil.intro}</p>
        <div class="knapper">
          <a class="knapp" href="#prosjekter">Se prosjektene</a>
          <a class="knapp knapp-sekundaer" href={`mailto:${profil.epost}`}>Send e-post</a>
        </div>
      </div>
    </section>

    <Seksjon id="om-meg" tittel="Om meg">
      <div class="om-meg">
        <div class="tekst">
          {profil.omMeg.map((avsnitt) => <p>{avsnitt}</p>)}
        </div>
        <div>
          <h3 class="undertittel">Teknologi jeg har jobbet med</h3>
          <dl class="teknologi">
            {
              teknologi.map((gruppe) => (
                <div>
                  <dt>{gruppe.kategori}</dt>
                  <dd>
                    <ul class="tagger">
                      {gruppe.teknologier.map((t) => <li>{t}</li>)}
                    </ul>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </Seksjon>

    <Seksjon id="prosjekter" tittel="Prosjekter">
      <div class="prosjekter">
        {prosjekter.map((prosjekt) => <ProsjektKort prosjekt={prosjekt} />)}
      </div>
    </Seksjon>

    <Seksjon id="erfaring" tittel="Erfaring">
      <ol class="tidslinje">
        {
          erfaring.map((e) => (
            <li>
              <p class="periode">{e.periode}</p>
              <div>
                <h3>{e.tittel}</h3>
                <p class="beskrivelse">{e.beskrivelse}</p>
                <ul class="punkter">
                  {e.punkter.map((punkt) => <li>{punkt}</li>)}
                </ul>
                {e.lenke && (
                  <a href={e.lenke.url} target="_blank" rel="noopener noreferrer">
                    {e.lenke.tekst} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>

      <h3 class="undertittel kurs-tittel">Kurs med kursbevis</h3>
      <ul class="kurs">
        {
          kurs.map((k) => (
            <li>
              <span class="kurs-navn">{k.navn}</span>
              <span class="kurs-utsteder">{k.utsteder}</span>
              {k.status && <span class="kurs-status">{k.status}</span>}
            </li>
          ))
        }
      </ul>
    </Seksjon>

    <Seksjon id="kontakt" tittel="Kontakt">
      <div class="kontakt">
        <p>
          Jeg ser etter fast jobb fra sommeren 2027. Den enkleste måten å nå meg på er e-post,
          men du finner meg også på LinkedIn.
        </p>
        <a class="epost" href={`mailto:${profil.epost}`}>{profil.epost}</a>
        <div class="kontakt-lenker">
          <a href={profil.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a href={profil.github} target="_blank" rel="noopener noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </Seksjon>
  </main>

  <Footer />
</Layout>

<style>
  /* Toppseksjon */
  .hero {
    padding-block: 7rem 6rem;
  }

  .hei {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  h1 {
    max-width: 22ch;
    margin-top: 1rem;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    letter-spacing: -0.02em;
  }

  .intro {
    max-width: 55ch;
    margin-top: 1.5rem;
    font-size: 1.1875rem;
    color: var(--text-muted);
  }

  .knapper {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  /* Felles for underoverskrifter i seksjonene */
  .undertittel {
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
  }

  /* Om meg */
  .om-meg {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .om-meg {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .tekst {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 60ch;
  }

  .teknologi {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
  }

  dt {
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  dd {
    margin: 0;
  }

  /* Prosjekter */
  .prosjekter {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 800px) {
    .prosjekter {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Erfaring */
  .tidslinje {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tidslinje > li {
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 700px) {
    .tidslinje > li {
      grid-template-columns: 10rem 1fr;
      gap: 2rem;
    }
  }

  .periode {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    padding-top: 0.2rem;
  }

  .tidslinje h3 {
    font-size: 1.25rem;
  }

  .beskrivelse {
    margin-top: 0.25rem;
    color: var(--text-muted);
  }

  .punkter {
    margin: 0.75rem 0;
    padding-left: 1.1rem;
  }

  .punkter li + li {
    margin-top: 0.35rem;
  }

  .kurs-tittel {
    margin-top: 4rem;
  }

  .kurs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kurs li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .kurs-navn {
    font-weight: 600;
  }

  .kurs-utsteder {
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .kurs-status {
    margin-left: auto;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  /* Kontakt */
  .kontakt {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 60ch;
  }

  .epost {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
  }

  .kontakt-lenker {
    display: flex;
    gap: 1.5rem;
  }
</style>
