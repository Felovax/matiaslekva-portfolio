---
// Siden GitHub Pages viser når en adresse ikke finnes. Astro bygger den til
// 404.html, og det filnavnet ser GitHub Pages etter.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { IKKE_FUNNET } from '../data/ikkeFunnet';
import { profil } from '../data/profil';

const forside = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout tittel={`${IKKE_FUNNET.tittel} – ${profil.navn}`} beskrivelse={IKKE_FUNNET.tekst} skjulForSok>
  <Header />

  {/* id="start": «Hopp til innholdet» peker hit, som på forsiden */}
  <main id="start" class="container ikke-funnet">
    <p class="kode">{IKKE_FUNNET.kode}</p>
    <h1>{IKKE_FUNNET.tittel}</h1>
    <p class="tekst">{IKKE_FUNNET.tekst}</p>
    <a class="knapp" href={forside}>{IKKE_FUNNET.knapp}</a>
  </main>

  <Footer />
</Layout>

<style>
  .ikke-funnet {
    /* Fyller skjermen, så bunnteksten havner nederst */
    min-height: calc(100vh - var(--header-height) - 6rem);
    padding-block: 6rem;
  }

  .kode {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .tekst {
    max-width: 50ch;
    margin-block: 1.5rem 2.5rem;
    color: var(--text-muted);
  }
</style>
