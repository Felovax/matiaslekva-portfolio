---
// Testside for dungeonen mens den bygges i fase 2.
// Slettes i steg 7, når dungeonen flyttes inn på forsiden.
import Layout from '../layouts/Layout.astro';
---

<Layout tittel="Dungeon-test" beskrivelse="Testside for dungeonen">
  <main class="container">
    <h1>Dungeon-test</h1>
    {/* width/height er spillets egen oppløsning. CSS under skalerer det opp. */}
    <canvas id="dungeon" width="368" height="144"></canvas>
  </main>
</Layout>

<script>
  // Denne koden kjører i nettleseren. Astro pakker main.ts og alt den
  // importerer til én liten JavaScript-fil som bare lastes på denne siden.
  import { startDungeon } from '../game/main';

  const canvas = document.getElementById('dungeon');
  if (canvas instanceof HTMLCanvasElement) {
    startDungeon(canvas);
  }
</script>

<style>
  main {
    padding-block: 3rem;
  }

  canvas {
    display: block;
    width: 100%;
    max-width: 1104px; /* 368 × 3: hver spillpiksel blir nøyaktig 3 × 3 skjermpiksler */
    margin-top: 2rem;
    background: #000;
    /* Ikke gjør pikslene uskarpe når canvaset skaleres opp */
    image-rendering: pixelated;
  }
</style>
